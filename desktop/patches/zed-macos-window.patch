     use super::*;

+    #[gpui::test]
+    fn deferred_frame_wake_coalesces_and_yields(cx: &mut gpui::TestAppContext) {
+        let calls = Rc::new(Cell::new(0));
+        let executor = cx.executor();
+        let started = executor.now();
+        let wake = deferred_frame_waker(cx.foreground_executor().clone(), executor.clone(), {
+            let calls = calls.clone();
+            move || {
+                assert!(executor.now().duration_since(started) >= Duration::from_millis(16));
+                calls.set(calls.get() + 1);
+                true
+            }
+        });
+        wake();
+        wake();
+        wake();
+        assert_eq!(calls.get(), 0, "a wake must never draw synchronously");
+        cx.run_until_parked();
+        assert_eq!(
+            calls.get(),
+            0,
+            "starting the task must still wait for the timer"
+        );
+        cx.executor().advance_clock(Duration::from_millis(15));
+        cx.run_until_parked();
+        assert_eq!(
+            calls.get(),
+            0,
+            "the delay must not collapse into the current frame"
+        );
+        cx.executor().advance_clock(Duration::from_millis(1));
+        cx.run_until_parked();
+        assert_eq!(calls.get(), 1, "pending requests share one delayed wake");
+        wake();
+        cx.run_until_parked();
+        cx.executor().advance_clock(Duration::from_millis(16));
+        cx.run_until_parked();
+        assert_eq!(calls.get(), 2, "the next frame must be able to rearm");
+    }
