+        // Exercise both a delivered wake and a temporarily unavailable callback.
+        for first_wake_succeeds in [true, false] {
+            let calls = Rc::new(Cell::new(0));
+            let holder = Rc::new(std::cell::RefCell::<Option<Rc<dyn Fn()>>>::new(None));
+            let wake = deferred_frame_waker(cx.foreground_executor().clone(), cx.executor(), {
+                let calls = calls.clone();
+                let holder = Rc::downgrade(&holder);
+                move || {
+                    calls.set(calls.get() + 1);
+                    if calls.get() == 1 {
+                        holder.upgrade().unwrap().borrow().as_ref().unwrap()();
+                        first_wake_succeeds
+                    } else {
+                        true
+                    }
+                }
+            });
+            *holder.borrow_mut() = Some(wake.clone());
