+/// Coalesce demand onto a later main-thread turn. Returning false from
+/// `try_wake` retains demand when a frame callback is temporarily unavailable.
+fn deferred_frame_waker(
+    foreground_executor: ForegroundExecutor,
+    background_executor: BackgroundExecutor,
+    try_wake: impl Fn() -> bool + 'static,
+) -> Rc<dyn Fn()> {
+    let pending = Rc::new(Cell::new(false));
+    let try_wake = Rc::new(try_wake);
+    Rc::new(move || {
+        if pending.replace(true) {
+            return;
+        }
+        let pending = pending.clone();
+        let try_wake = try_wake.clone();
+        let background_executor = background_executor.clone();
+        foreground_executor
+            .spawn(async move {
+                loop {
+                    background_executor.timer(Duration::from_millis(16)).await;
+                    // Clear before AppKit is called so a reentrant request can
+                    // enqueue the next turn instead of being lost to coalescing.
+                    pending.set(false);
+                    if try_wake() || pending.replace(true) {
+                        // A successful wake served this request. If a failed
+                        // attempt enqueued another wake reentrantly, that new
+                        // task owns the retry; otherwise retain this task.
+                        break;
+                    }
+                }
+            })
+            .detach();
+    })
+}
